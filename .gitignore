# Whitelist: only the plugin, its build/test/release scripts and the update tool are published.
# Everything else in this folder (reverse-engineering material, saves, logs, backups, experiments) stays local.
/*
!/.gitignore
!/.gitmodules
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/build.bat
!/install.bat
!/package.bat
!/src/
!/include/
!/tests/
!/tools/
!/packaging/
!/sdk/
!/libs/
!/docs/

# inside whitelisted folders
/sdk/examples/
/tools/scs_archive/
/tools/known_good.json
__pycache__/
*.log
*.obj
*.exe
*.dll
*.lib
*.exp
*.bak_*
